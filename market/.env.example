# Which implementations back the ports in app/ports.py.
#   stub  — self-contained fakes in app/adapters/ (seed catalogue, placeholder
#           price engine, JSONL order log). C1 runs with no other slice up.
#   http  — call the real B1/B2 services over HTTP.
CRAFTLY_ADAPTERS=stub

# Only read when CRAFTLY_ADAPTERS=http.
CRAFTLY_PLATFORM_URL=http://localhost:8000
CRAFTLY_ENGINES_URL=http://localhost:8010

# Where placed orders are appended when the stub order sink is in use.
CRAFTLY_ORDERS_PATH=orders.jsonl

# Where built reels and their intermediate frames are written.
CRAFTLY_REELS_DIR=reels

# ffmpeg binary used by app/reel.py. Reels are the only thing that needs it;
# every other surface works without it.
CRAFTLY_FFMPEG=ffmpeg

# Public base URL baked into QR codes. Must be reachable from a phone —
# localhost will not scan from another device.
CRAFTLY_PUBLIC_URL=http://localhost:8100
