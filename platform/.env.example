# ---------------------------------------------------------------------------
# Craftly platform (B2). Every value here has a working default — this file
# is a map of what can be changed, not a list of what must be.
# ---------------------------------------------------------------------------

# SQLAlchemy URL. SQLite needs nothing installed and is the default so that
# a fresh clone has a database. Postgres works unchanged:
#   CRAFTLY_DATABASE_URL=postgresql+psycopg://craftly:secret@localhost/craftly
CRAFTLY_DATABASE_URL=sqlite:///craftly.db

# Where uploads land (content-addressed) and where minted QR PNGs are cached.
CRAFTLY_MEDIA_DIR=media
CRAFTLY_QR_DIR=qr
CRAFTLY_MAX_UPLOAD_BYTES=12582912

# Baked into every QR code. This is C1's address, not this service's: a
# scanned tag lands on C1's /p/{code} page. It MUST be reachable from a
# phone — a QR pointing at localhost scans to nothing on another device.
CRAFTLY_PUBLIC_URL=http://localhost:8100

# Where this service is reachable, used to build absolute media URLs.
CRAFTLY_PLATFORM_SELF_URL=http://localhost:8200

# Token signing/config secret. Unset is safe for one worker (tokens are
# random either way); set it before running more than one.
CRAFTLY_SECRET_KEY=

CRAFTLY_TOKEN_TTL_SECONDS=2592000
CRAFTLY_OTP_TTL_SECONDS=600
CRAFTLY_OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# The two insecure-by-design defaults. Both are listed in GET /health and
# logged at startup so they cannot ship quietly.
# ---------------------------------------------------------------------------

# Returns the login code in the response body. There is no SMS gateway in
# this repo (C2 owns delivery) and a login you cannot complete is not a
# login. Turn OFF before this is reachable from the internet.
CRAFTLY_OTP_ECHO=true

# C1's order adapter sends no Authorization header yet. Leaving this false
# keeps that integration working; turn it on once C1 sends a token.
CRAFTLY_REQUIRE_ORDER_AUTH=false

# Share of the margin ABOVE the wage floor that the marketplace keeps.
# Applied to (price - artisan take-home), never to the price.
CRAFTLY_PLATFORM_FEE_PCT=0.10

# Where `python -m app.seed` reads its catalogue from.
CRAFTLY_SEED_DIR=../market/seed
