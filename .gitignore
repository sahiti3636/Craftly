market/media_cache/
market/qr/
market/orders.jsonl
market/*.log

# platform/ (B2) — all generated, all rebuildable from `python -m app.seed`.
platform/craftly.db
platform/craftly.db-wal
platform/craftly.db-shm
platform/media/
platform/qr/
platform/*.log

# integrations/ (C2) — simulated shipment and call logs, rebuildable by running the demo.
integrations/logs/
