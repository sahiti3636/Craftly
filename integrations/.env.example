# Where C1 (market/) is running. Channel pushes read priced listings from
# GET {CRAFTLY_C1_URL}/api/products/{id}?channel=amazon. If C1 is not up,
# the bridge falls back to loading C1's code in-process (needs C1's
# dependencies installed) and then to a plain seed-data payload.
CRAFTLY_C1_URL=http://127.0.0.1:8100

# C1's placed-order log. Courier booking and the AI call read from it.
# Defaults to ../market/orders.jsonl.
# CRAFTLY_ORDERS_PATH=../market/orders.jsonl

# C1's seed directory (listings, artisans, inventory). Defaults to ../market/seed.
# CRAFTLY_SEED_DIR=../market/seed

# Where the simulated shipments and call logs are appended.
CRAFTLY_C2_LOG_DIR=logs

# The order date the simulation treats as "today". Unset = real today.
# CRAFTLY_C2_TODAY=2026-09-20

# B2 (the platform). Set CRAFTLY_SERVICE_TOKEN to the same value as in
# platform/.env and C2 reads its orders from B2, records deliveries there
# (which settles the payout) and only calls artisans who agreed to AI calls
# in Craftly Studio. Unset, C2 uses C1's order log as before.
CRAFTLY_PLATFORM_URL=http://127.0.0.1:8200
CRAFTLY_SERVICE_TOKEN=
